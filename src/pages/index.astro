---
import Layout from '~/layouts/Layout.astro';

const metadata = {
  title: 'Ferensway — Digital, data and AI consultancy',
  ignoreTitleTemplate: true,
  description:
    'Ferensway helps established businesses improve how they operate using practical digital technology, data and AI.',
};

const email = 'dan.humphreys@ferensway.com';
---

<Layout metadata={metadata}>
  <header class="border-b border-[#17313a]/15 bg-[#f5f2eb]">
    <div class="mx-auto flex min-h-20 max-w-[90rem] items-center justify-between px-5 sm:px-8 lg:px-12">
      <a href="/" class="text-[0.92rem] font-semibold tracking-[0.24em] text-[#102b35]" aria-label="Ferensway home">
        FERENSWAY
      </a>

      <nav class="hidden items-center gap-8 text-[0.9rem] text-[#43575d] md:flex" aria-label="Main navigation">
        <a class="transition-colors hover:text-[#102b35]" href="#how-we-help">How we help</a>
        <a class="transition-colors hover:text-[#102b35]" href="#how-we-work">How we work</a>
        <a class="transition-colors hover:text-[#102b35]" href="#about">About</a>
      </nav>

      <a
        href={`mailto:${email}`}
        class="border-b border-[#a5452f] pb-1 text-[0.9rem] font-medium text-[#102b35] transition-colors hover:text-[#a5452f]"
      >
        Talk to us
      </a>
    </div>
  </header>

  <main>
    <section class="relative overflow-hidden bg-[#f5f2eb]">
      <div
        class="mx-auto grid min-h-[calc(100svh-5rem)] max-w-[90rem] grid-cols-1 px-5 sm:px-8 lg:grid-cols-12 lg:px-12"
      >
        <div class="flex flex-col justify-center py-20 lg:col-span-9 lg:py-28">
          <p class="mb-8 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#6e7c7e]">
            <span class="block h-px w-8 bg-[#a5452f]"></span>
            Hull, East Yorkshire
          </p>

          <h1
            class="max-w-6xl font-serif text-[clamp(2.75rem,7.6vw,7.6rem)] leading-[0.96] tracking-[-0.045em] text-[#102b35]"
          >
            Digital, data and AI,<br />
            <span class="text-[#a5452f]">applied to real</span><br />
            business problems.
          </h1>

          <div
            class="mt-12 grid max-w-4xl gap-8 border-t border-[#17313a]/20 pt-8 sm:grid-cols-[1fr_auto] sm:items-end"
          >
            <p class="max-w-2xl text-lg leading-8 text-[#43575d] sm:text-xl">
              We help established businesses identify and implement practical ways to improve how they operate.
            </p>
            <a
              href={`mailto:${email}`}
              class="inline-flex min-h-12 items-center justify-center bg-[#102b35] px-6 text-sm font-semibold text-white transition-colors hover:bg-[#a5452f] focus:outline-none focus:ring-2 focus:ring-[#a5452f] focus:ring-offset-4 focus:ring-offset-[#f5f2eb]"
            >
              Start a conversation
            </a>
          </div>
        </div>

        <div class="hidden border-l border-[#17313a]/15 lg:col-span-3 lg:flex lg:items-end lg:justify-end lg:py-12">
          <p class="max-w-44 text-right text-sm leading-6 text-[#6e7c7e]">
            Technology chosen for the outcome—not for the fashion.
          </p>
        </div>
      </div>
    </section>

    <section id="how-we-help" class="scroll-mt-8 bg-white py-24 sm:py-32">
      <div class="mx-auto max-w-[90rem] px-5 sm:px-8 lg:px-12">
        <div class="grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <p class="eyebrow">How we help</p>
            <h2 class="section-title mt-5">Start with the problem. Then choose the technology.</h2>
          </div>
          <div class="lg:col-span-7 lg:col-start-6">
            <p class="max-w-3xl text-xl leading-9 text-[#43575d] sm:text-2xl">
              Good technology should remove friction, improve decisions or make valuable work easier. We look at how
              your organisation actually operates before recommending what to change.
            </p>

            <ol class="mt-14 border-t border-[#17313a]/20">
              <li class="service-row">
                <span class="service-number">01</span>
                <div>
                  <h3 class="service-title">Improve inefficient workflows</h3>
                  <p class="service-copy">
                    Reduce manual administration, duplicated data entry and avoidable hand-offs.
                  </p>
                </div>
              </li>
              <li class="service-row">
                <span class="service-number">02</span>
                <div>
                  <h3 class="service-title">Connect systems and information</h3>
                  <p class="service-copy">Help existing software, documents and data work together more effectively.</p>
                </div>
              </li>
              <li class="service-row">
                <span class="service-number">03</span>
                <div>
                  <h3 class="service-title">Make better use of data</h3>
                  <p class="service-copy">
                    Create clearer information, more reliable reporting and a stronger basis for decisions.
                  </p>
                </div>
              </li>
              <li class="service-row">
                <span class="service-number">04</span>
                <div>
                  <h3 class="service-title">Apply automation and AI where useful</h3>
                  <p class="service-copy">
                    Use the least complicated approach that can produce the required business outcome.
                  </p>
                </div>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section id="how-we-work" class="scroll-mt-8 border-y border-[#17313a]/15 bg-[#e9e5dc] py-24 sm:py-32">
      <div class="mx-auto max-w-[90rem] px-5 sm:px-8 lg:px-12">
        <div class="grid gap-8 border-b border-[#17313a]/20 pb-12 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow">How we work</p>
            <h2 class="section-title mt-5 max-w-3xl">A practical route from opportunity to lasting improvement.</h2>
          </div>
          <p class="max-w-xl text-lg leading-8 text-[#43575d] lg:col-span-4 lg:col-start-9">
            Each stage stands on its own. We can help you understand the opportunity, deliver the right change and
            support it where ongoing operation adds value.
          </p>
        </div>

        <ol class="grid lg:grid-cols-3">
          <li class="process-step lg:pr-10">
            <span class="process-number">01</span>
            <h3 class="process-title">Discover</h3>
            <p class="process-copy">
              Understand workflows, systems and data. Identify opportunities and assess them by value, feasibility,
              cost, risk and time to value.
            </p>
          </li>
          <li class="process-step lg:border-l lg:border-[#17313a]/20 lg:px-10">
            <span class="process-number">02</span>
            <h3 class="process-title">Deliver</h3>
            <p class="process-copy">
              Implement worthwhile improvements—from workflow automation and integration to bespoke software, data
              platforms or AI-enabled systems.
            </p>
          </li>
          <li class="process-step lg:border-l lg:border-[#17313a]/20 lg:pl-10">
            <span class="process-number">03</span>
            <h3 class="process-title">Operate</h3>
            <p class="process-copy">
              Where appropriate, support, monitor and improve the solutions we implement so they continue to work well
              as the business changes.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <section class="bg-[#102b35] py-24 text-white sm:py-32">
      <div class="mx-auto grid max-w-[90rem] gap-14 px-5 sm:px-8 lg:grid-cols-12 lg:px-12">
        <div class="lg:col-span-4">
          <p class="eyebrow !text-[#d28a76]">Who we work with</p>
          <h2 class="mt-5 max-w-md font-serif text-4xl leading-tight tracking-[-0.025em] sm:text-5xl">
            Established businesses with complicated work to do.
          </h2>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <p class="max-w-3xl text-xl leading-9 text-[#ced8d7] sm:text-2xl">
            Ferensway is particularly suited to organisations whose day-to-day work crosses several systems,
            spreadsheets, documents and teams—and where that complexity has become expensive.
          </p>
          <div
            class="mt-14 grid gap-x-8 gap-y-4 border-t border-white/20 pt-8 text-sm leading-6 text-[#aebfbe] sm:grid-cols-2"
          >
            <p>Manufacturing and engineering</p>
            <p>Logistics and distribution</p>
            <p>Construction and wholesale</p>
            <p>Professional and business services</p>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="scroll-mt-8 bg-white py-24 sm:py-32">
      <div class="mx-auto grid max-w-[90rem] gap-12 px-5 sm:px-8 lg:grid-cols-12 lg:px-12">
        <div class="lg:col-span-4">
          <p class="eyebrow">About Ferensway</p>
          <h2 class="section-title mt-5">Engineering judgement, applied to digital change.</h2>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <p class="text-xl leading-9 text-[#253f47] sm:text-2xl">
            Ferensway is an independent digital, data and AI consultancy founded in Hull by Dan Humphreys, a Chartered
            Engineer with a background spanning physical engineering, software, data and large-scale public-sector
            systems.
          </p>
          <div class="mt-10 grid gap-8 border-t border-[#17313a]/20 pt-8 sm:grid-cols-2">
            <p class="text-base leading-7 text-[#52676c]">
              Dan’s experience includes engineering and analytical work at BAE Systems, followed by software, data and
              cloud work across NHS Digital and the Ministry of Justice/HMPPS.
            </p>
            <p class="text-base leading-7 text-[#52676c]">
              That breadth shapes Ferensway’s approach: understand the whole system, make complexity manageable and use
              technology in proportion to the problem.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="bg-[#a5452f] py-20 text-white sm:py-24">
      <div class="mx-auto grid max-w-[90rem] gap-10 px-5 sm:px-8 lg:grid-cols-12 lg:items-end lg:px-12">
        <div class="lg:col-span-8">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/70">Start a conversation</p>
          <h2 class="mt-5 max-w-4xl font-serif text-4xl leading-tight tracking-[-0.03em] sm:text-6xl">
            Tell us where work is more difficult than it should be.
          </h2>
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <p class="mb-5 text-base leading-7 text-white/80">
            A straightforward conversation is the best place to begin.
          </p>
          <a
            href={`mailto:${email}`}
            class="inline-block border-b border-white pb-1 text-lg font-semibold transition-opacity hover:opacity-70 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-4 focus:ring-offset-[#a5452f]"
          >
            {email}
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-[#0b2028] py-8 text-[#9eb0b1]">
    <div
      class="mx-auto flex max-w-[90rem] flex-col gap-5 px-5 text-sm sm:px-8 md:flex-row md:items-center md:justify-between lg:px-12"
    >
      <p class="font-semibold tracking-[0.2em] text-white">FERENSWAY</p>
      <p>Hull, East Yorkshire, UK</p>
      <p>&copy; {new Date().getFullYear()} Ferensway</p>
    </div>
  </footer>
</Layout>

<style>
  .eyebrow {
    color: #a5452f;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .section-title {
    color: #102b35;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.35rem, 4.5vw, 4.5rem);
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .service-row {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1rem;
    border-bottom: 1px solid rgb(23 49 58 / 20%);
    padding: 1.75rem 0;
  }

  .service-number,
  .process-number {
    color: #a5452f;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .service-title,
  .process-title {
    color: #102b35;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.55rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .service-copy,
  .process-copy {
    margin-top: 0.65rem;
    max-width: 42rem;
    color: #52676c;
    font-size: 1rem;
    line-height: 1.75;
  }

  .process-step {
    padding-bottom: 2.5rem;
    padding-top: 2.5rem;
  }

  .process-title {
    margin-top: 2rem;
    font-size: 2rem;
  }

  @media (min-width: 64rem) {
    .process-step {
      padding-bottom: 0;
      padding-top: 3rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
</style>
