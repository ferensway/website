---
import Layout from '~/layouts/Layout.astro';
---

<Layout metadata={{ title: 'Page not found — Ferensway', robots: { index: false, follow: false } }}>
  <main class="flex min-h-screen items-center bg-[#f5f2eb] px-5 py-20">
    <div class="mx-auto w-full max-w-4xl">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a5452f]">404</p>
      <h1 class="mt-5 font-serif text-5xl tracking-[-0.04em] text-[#102b35] sm:text-7xl">Page not found.</h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-[#52676c]">The page you were looking for does not exist.</p>
      <a class="mt-10 inline-block border-b border-[#a5452f] pb-1 font-semibold text-[#102b35]" href="/">Return home</a>
    </div>
  </main>
</Layout>
